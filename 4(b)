import 'package:utter/material.dart';
void main() {
runApp(const MyApp());
}
class MyApp extends StatelessWidget {
const MyApp({super.key});
@override
Widget build(BuildContext context) {
return MaterialApp(
title: 'Named Routes Demo',
debugShowCheckedModeBanner: false,
initialRoute: '/',
routes: {
'/': (context) => const HomePage(),
'/about': (context) => const AboutPage(),
},
onGenerateRoute: (settings) {
if (settings.name == '/details') {
nal args = settings.arguments as DetailsPageArguments;
return MaterialPageRoute(
builder: (context) => DetailsPage(
title: args.title,
message: args.message,
),
);
}
return null;
},
onUnknownRoute: (settings) {
return MaterialPageRoute(
builder: (context) => const UnknownPage(),
);
},
);
}
}
// ---------------- HOME PAGE ----------------
class HomePage extends StatelessWidget {
const HomePage({super.key});
@override
Widget build(BuildContext context) {
return Scaold(
appBar: AppBar(
title: const Text('Home Page'),
backgroundColor: Colors.teal,
foregroundColor: Colors.white,
),
body: Center(
child: Padding(
padding: const EdgeInsets.all(16),
child: Column(
mainAxisAlignment: MainAxisAlignment.center,
children: [
ElevatedButton(
onPressed: () {
Navigator.pushNamed(
context,
'/about',
);
},
child: const Text('Go to About Page'),
),
const SizedBox(height: 15),
ElevatedButton(
onPressed: () {
Navigator.pushNamed(
context,
'/details',
arguments: const DetailsPageArguments(
title: 'Details Page',
message: 'is is a message from Home Page!',
),
);
},
child: const Text(
'Go to Details Page with Arguments',
),
),
const SizedBox(height: 15),
ElevatedButton(
onPressed: () {
Navigator.pushNamed(
context,
'/undened',
);
},
child: const Text(
'Go to Undened Route',
),
),
],
),
),
),
);
}
}
// ---------------- ABOUT PAGE ----------------
class AboutPage extends StatelessWidget {
const AboutPage({super.key});
@override
Widget build(BuildContext context) {
return Scaold(
appBar: AppBar(
title: const Text('About Page'),
backgroundColor: Colors.deepPurple,
foregroundColor: Colors.white,
),
body: Center(
child: Column(
mainAxisAlignment: MainAxisAlignment.center,
children: [
const Text(
'is is the About Page',
style: TextStyle(
fontSize: 20,
fontWeight: FontWeight.bold,
),
),
const SizedBox(height: 20),
ElevatedButton(
onPressed: () {
Navigator.pop(context);
},
child: const Text('Go Back'),
),
],
),
),
);
}
}
// ---------------- DETAILS PAGE ----------------
class DetailsPage extends StatelessWidget {
nal String title;
nal String message;
const DetailsPage({
super.key,
required this.title,
required this.message,
});
@override
Widget build(BuildContext context) {
return Scaold(
appBar: AppBar(
title: Text(title),
backgroundColor: Colors.orange,
),
body: Center(
child: Column(
mainAxisAlignment: MainAxisAlignment.center,
children: [
Text(
message,
style: const TextStyle(
fontSize: 18,
fontWeight: FontWeight.bold,
),
),
const SizedBox(height: 20),
ElevatedButton(
onPressed: () {
Navigator.pop(context);
},
child: const Text('Back to Home'),
),
],
),
),
);
}
}
// ---------------- ARGUMENT CLASS ----------------
class DetailsPageArguments {
nal String title;
nal String message;
const DetailsPageArguments({
required this.title,
required this.message,
});
}
// ---------------- UNKNOWN PAGE ----------------
class UnknownPage extends StatelessWidget {
const UnknownPage({super.key});
@override
Widget build(BuildContext context) {
return Scaold(
appBar: AppBar(
title: const Text('404 - Not Found'),
backgroundColor: Colors.red,
foregroundColor: Colors.white,
),
body: Center(
child: Column(
mainAxisAlignment: MainAxisAlignment.center,
children: [
const Text(
"Oops! e page you requested doesn't exist.",
style: TextStyle(
fontSize: 18,
fontWeight: FontWeight.bold,
),
),
const SizedBox(height: 20),
ElevatedButton(
onPressed: () {
Navigator.pop(context);
},
child: const Text('Go Back'),
),
],
),
),
);
}
}
